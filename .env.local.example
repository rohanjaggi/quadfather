# Supabase PostgreSQL (use connection pooler URL for serverless)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true

# Telegram bot token from @BotFather
BOTFATHER_TOKEN=

# OpenAI API key (for meal photo analysis)
OPENAI_API_KEY=

# Telegram webhook config (production only)
WEBHOOK_URL=https://your-app.vercel.app
WEBHOOK_SECRET=

# URL the bot's inline buttons link to
MINI_APP_URL=https://your-app.vercel.app

# Local dev only — skip Telegram auth validation
SKIP_TELEGRAM_AUTH=true
DEV_USER_ID=your-telegram-id
