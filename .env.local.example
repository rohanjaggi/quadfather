# Every variable this codebase actually reads. Nothing here is unused, and
# nothing used is missing — keep it that way when adding one.

# --- Required ---

# Supabase PostgreSQL — use the connection pooler URL for serverless
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true

# Telegram bot token from @BotFather. Also the HMAC secret for verifying
# Mini App initData, so the app fails closed if it is missing.
BOTFATHER_TOKEN=

# 32-byte hex (64 chars) — encrypts user AI keys and Strava tokens at rest,
# and signs the Strava OAuth `state`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Telegram webhook + Mini App (production) ---

# Deployment origin the Telegram webhook is registered against
WEBHOOK_URL=https://your-app.vercel.app

# Random string; forms the secret path segment /api/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Deployment origin the bot's inline buttons open. Unset = buttons are omitted.
MINI_APP_URL=https://your-app.vercel.app

# --- Cron ---

# Shared secret for /api/cron/*, sent as `Authorization: Bearer <CRON_SECRET>`.
# Unset = the cron routes refuse to run (500), never accept-all.
CRON_SECRET=

# --- Server-side AI fallback (optional) ---
# Used only for users who have not saved their own key. Gemini is tried first.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Strava integration (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-app.vercel.app/api/strava/callback

# --- Local dev only ---
# Bypasses Telegram initData verification. Never set this in production.
SKIP_TELEGRAM_AUTH=true
DEV_USER_ID=your-telegram-id
