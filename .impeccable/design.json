      "html": "<label class=\"ds-label\">Calories<input class=\"ds-input\" placeholder=\"e.g. 540\"></label>",
      "css": ".ds-label{font-family:'Figtree',system-ui,sans-serif;display:block;font-size:13px;font-weight:600;color:#646B66}.ds-input{font-family:'Figtree',system-ui,sans-serif;display:block;margin-top:6px;width:100%;min-height:48px;border-radius:14px;padding:12px 14px;font-size:16px;border:1px solid rgba(31,42,36,.13);outline:none;background:#fff;color:#1F2A24;transition:box-shadow .2s,border-color .2s}.ds-input::placeholder{color:#646B66}.ds-input:focus{border-color:#2F6B4F;box-shadow:0 0 0 3px rgba(47,107,79,.16)}"
