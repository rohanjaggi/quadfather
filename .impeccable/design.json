  "narrative": {
    "northStar": "The Kind Kitchen Notebook",
    "overview": "A warm consumer app done with real care. Warm paper ground, white cards that each answer one question, plain sentence-case words, and a single deep green that only ever means \"tap me\". Numbers are the heroes: big, tabular, set in Figtree at 700 with tight tracking, so \"940 kcal left\" reads without arithmetic.\n\nDensity is phone-native and generous. One column at 390px inside Telegram's chrome, cards stacked 12px apart, rows at least 52px tall. Colour beyond ink and green is reserved for data: muted clay, berry, ochre, sand, olive, slate and sage tints mark progress, never words. The only flourish is a four-stop gradient (clay, green, ochre, slate) that appears in exactly four places and never moves twice at once.\n\nThe system rejects the template it replaced: tracked uppercase micro-labels, tinted-smudge cards, progress rings, and a fade-up cascade replaying on every block.",
    "keyCharacteristics": [
      "Warm ground, white 20px cards, hairline borders, a barely-there shadow.",
      "One action green; metric tints for data marks only.",
      "Figtree throughout, tabular numerals on every figure.",
      "Goals read as under / at / over, never as rings.",
      "One page entrance per navigation; one moving gradient at a time.",
      "Thin-stroke icons drawn as one set (24px grid, 1.7 stroke, round caps)."
    ],
    "rules": [
      {
        "name": "The Green Means Tap Rule",
        "body": "Field Green appears only on something the user can press. If it is not interactive, it is ink, stone, a data tint, or brick. The single exception is the at-goal \"done\" word and check.",
        "section": "colors"
      },
      {
        "name": "The Tints Are Marks Rule",
        "body": "Metric tints colour bars, pips, blocks and chart marks only. Labels and values beside them stay ink or stone.",
        "section": "colors"
      },
      {
        "name": "The Fixed Palette Rule",
        "body": "The app ships its own palette and overrides Telegram's `--tg-theme-*` variables; it does not follow the client's theme.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "No uppercase, no letter-spaced micro-labels, no eyebrow above a title. A group title is 13px/600 stone in sentence case.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure is tabular. Units (\"kcal\", \"g\", \"L\") sit beside the number in stone at a smaller size.",
        "section": "typography"
      },
      {
        "name": "The Hairline First Rule",
        "body": "Cards separate from the ground by a 1px `line` border; shadow is a whisper, never a drop.",
        "section": "elevation"
      },
      {
        "name": "The One Moving Gradient Rule",
        "body": "Never more than one gradient moves at a time. The date pauses (`body:has(.gradient-sweep, .row-landed, .ai-shimmer)`) while any other moment plays, and goal sweeps share one queue: each waits 1.9s for the landing wash, then for any earlier sweep, so a log that crosses calories and protein lights them in turn.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep Field Green (#2F6B4F) on tappable elements only; the at-goal \"done\" word and check are the one exception.",
      "**Do** colour data marks with the metric tints and keep their labels ink or stone.",
      "**Do** show every goal metric as under / at / over, with brick only where over is bad.",
      "**Do** lead each screen with one tabular hero figure and plain sentence-case words.",
      "**Do** use PageHeader for every page title, and give sub-pages a `back` so Telegram's native button appears.",
      "**Do** import Telegram hooks from `src/components/telegram.ts` and keep the SDK inside the client-only provider.",
      "**Do** route new gradient motion through the four moments and the shared sweep queue.",
      "**Do** draw new icons on the 24px, 1.7-stroke, round-cap grid in `icons.tsx`."
    ],
    "donts": [
      "**Don't** use uppercase or letter-spaced micro-labels, or put an eyebrow above a title.",
      "**Don't** draw progress rings; use lines, columns, pips or blocks.",
      "**Don't** add a per-block fade-up cascade; the page entrance plays once in `template.tsx`.",
      "**Don't** let two gradients move at once, or add a fifth gradient moment.",
      "**Don't** use metric tints for text.",
      "**Don't** add a fifth tab or put Settings in the nav.",
      "**Don't** import `@twa-dev/sdk` from a page or any module rendered during prerender.",
      "**Don't** animate `transform` on a page wrapper; it re-parents fixed sheets and docks."
    ]
  }
}