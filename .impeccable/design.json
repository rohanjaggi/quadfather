      "kind": "custom",
      "refersTo": "segmented",
      "description": "The one segmented control; white selected tab in a track well.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\" aria-label=\"Range\"><button role=\"radio\" aria-checked=\"true\">Week</button><button role=\"radio\" aria-checked=\"false\">Month</button></div>",
      "css": ".ds-seg{font-family:'Figtree',system-ui,sans-serif;display:flex;padding:3px;gap:2px;border-radius:14px;background:#F1ECE6}.ds-seg button{flex:1;min-height:36px;padding:6px 10px;border:none;border-radius:11px;background:transparent;color:#646B66;font:inherit;font-size:14px;font-weight:600;cursor:pointer}.ds-seg button[aria-checked=\"true\"]{background:#fff;color:#1F2A24;box-shadow:0 1px 3px rgba(31,42,36,.1)}.ds-seg button:focus-visible{outline:2px solid #2F6B4F;outline-offset:2px}"
    },
    {
      "name": "Progress Line",
      "kind": "custom",
      "refersTo": "",
      "description": "Goal line with under, at and over states; tint fill, brick when over.",
      "html": "<div class=\"ds-pl\"><div class=\"ds-pl-row\"><span>Calories</span><span><b>1,460</b> / 2,400 kcal</span></div><div class=\"ds-pl-track\"><i style=\"width:61%\"></i></div></div><div class=\"ds-pl ds-over\"><div class=\"ds-pl-row\"><span>Carbs</span><span><b>260</b> / 220 g <em>· 40 over</em></span></div><div class=\"ds-pl-track\"><i style=\"width:100%\"></i></div></div>",
      "css": ".ds-pl{font-family:'Figtree',system-ui,sans-serif;margin-bottom:16px;color:#1F2A24;font-variant-numeric:tabular-nums}.ds-pl-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px;font-size:15px}.ds-pl-row span:last-child{font-size:14px;color:#646B66}.ds-pl-row b{font-size:16px;font-weight:600;color:#1F2A24}.ds-pl-row em{font-style:normal;color:#B4432F;font-weight:500}.ds-pl-track{position:relative;height:6px;border-radius:3px;background:#F1ECE6;overflow:hidden}.ds-pl-track i{position:absolute;inset:0 auto 0 0;border-radius:3px;background:#CB8C76;transition:width .8s cubic-bezier(.16,1,.3,1)}.ds-over b{color:#B4432F}.ds-over .ds-pl-track i{background:#B4432F}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "nav-tab-active",
      "description": "Four tabs plus a centre green Log button; Settings lives behind the Today avatar.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><a href=\"#\" aria-current=\"page\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4v-5.5h-6V20H5a1 1 0 0 1-1-1z\"/></svg></span>Today</a><a href=\"#\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 3v18\"/><path d=\"M4.5 3v5a2.5 2.5 0 0 0 5 0V3\"/><path d=\"M17.5 21V3c-2 1.4-3 4-3 7.5h3\"/></svg></span>Food</a><div><button aria-label=\"Log\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button></div><a href=\"#\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 6.5v11M17 6.5v11\"/><path d=\"M4 9.5v5M20 9.5v5\"/><path d=\"M7 12h10\"/></svg></span>Training</a><a href=\"#\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16\"/><path d=\"M5 15.5l4.5-4.5 3 3L19 7.5\"/><path d=\"M15 7.5h4v4\"/></svg></span>Trends</a></nav>",
      "css": ".ds-nav{font-family:'Figtree',system-ui,sans-serif;display:grid;grid-template-columns:1fr 1fr 76px 1fr 1fr;align-items:start;height:68px;background:rgba(251,248,244,.94);backdrop-filter:saturate(1.4) blur(18px);-webkit-backdrop-filter:saturate(1.4) blur(18px);border-top:1px solid rgba(31,42,36,.07)}.ds-nav a{display:flex;flex-direction:column;align-items:center;gap:3px;padding-top:7px;font-size:12px;font-weight:600;color:#646B66;text-decoration:none}.ds-nav a span{display:grid;place-items:center;width:54px;height:30px;border-radius:15px;transition:background-color .25s}.ds-nav a[aria-current=\"page\"]{color:#2F6B4F}.ds-nav a[aria-current=\"page\"] span{background:rgba(47,107,79,.11)}.ds-nav div{display:grid;place-items:center;padding-top:6px}.ds-nav button{width:54px;height:54px;border-radius:27px;border:none;background:#2F6B4F;color:#fff;display:grid;place-items:center;box-shadow:0 6px 16px -6px rgba(47,107,79,.6);cursor:pointer;transition:transform .15s}.ds-nav button:active{transform:scale(.98)}.ds-nav a:focus-visible,.ds-nav button:focus-visible{outline:2px solid #2F6B4F;outline-offset:2px}"
    },
    {
      "name": "Gradient Date",
      "kind": "custom",
      "refersTo": "",
      "description": "Today's drifting date: the first of the four gradient moments.",
      "html": "<h1 class=\"ds-date\">November 20</h1>",
      "css": "@keyframes ds-drift{from{background-position:0% 50%}to{background-position:100% 50%}}.ds-date{font-family:'Figtree',system-ui,sans-serif;margin:0;font-size:52px;font-weight:700;line-height:1.04;letter-spacing:-.035em;background:linear-gradient(100deg,#C0705A,#2F6B4F 36%,#D9A441 66%,#5C7FA3);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;animation:ds-drift 18s ease-in-out infinite alternate}@media (prefers-reduced-motion:reduce){.ds-date{animation:none}}"
