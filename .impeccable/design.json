      "css": ".ds-pill{font-family:'Figtree',system-ui,sans-serif;min-height:36px;padding:8px 14px;border-radius:99px;border:1px solid rgba(31,42,36,.13);background:#fff;color:#1F2A24;font-size:14px;font-weight:600;cursor:pointer;transition:background-color .2s,color .2s}.ds-pill[data-active=\"true\"]{background:rgba(47,107,79,.11);color:#2F6B4F;border-color:transparent}.ds-pill:focus-visible{outline:2px solid #2F6B4F;outline-offset:2px}"
