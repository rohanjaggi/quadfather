      "description": "White surface that answers one question.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Left today</h2><p class=\"ds-hero\">940<span>kcal</span></p></section>",
      "css": ".ds-card{font-family:'Figtree',system-ui,sans-serif;background:#fff;border:1px solid rgba(31,42,36,.07);border-radius:20px;box-shadow:0 1px 3px rgba(31,42,36,.04);padding:18px 20px;color:#1F2A24}.ds-card-title{margin:0;font-size:15px;font-weight:600;color:#646B66}.ds-hero{margin:2px 0 0;font-size:64px;font-weight:700;letter-spacing:-.045em;line-height:1;font-variant-numeric:tabular-nums}.ds-hero span{margin-left:6px;font-size:20px;font-weight:600;letter-spacing:0;color:#646B66}"
