    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one green call to action per card; full width.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Log a meal</button>",
      "css": ".ds-btn-primary{font-family:'Figtree',system-ui,sans-serif;width:100%;min-height:52px;padding:14px 18px;border-radius:16px;border:none;background:var(--action,#2F6B4F);color:#fff;font-size:16px;font-weight:600;letter-spacing:-0.005em;box-shadow:0 2px 6px rgba(47,107,79,.18);display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:opacity .2s ease,transform .15s cubic-bezier(.22,1,.36,1)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid #2F6B4F;outline-offset:2px}.ds-btn-primary:disabled{opacity:.4;box-shadow:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered white button for the second choice.",
      "html": "<button class=\"ds-btn-secondary\">Cancel</button>",
      "css": ".ds-btn-secondary{font-family:'Figtree',system-ui,sans-serif;min-height:48px;padding:12px 16px;border-radius:14px;border:1px solid rgba(31,42,36,.13);background:#fff;color:#1F2A24;font-size:15px;font-weight:600;cursor:pointer;transition:background-color .15s ease,transform .15s}.ds-btn-secondary:hover{background:#F3EEE8}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:2px solid #2F6B4F;outline-offset:2px}"
    },
