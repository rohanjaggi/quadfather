generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  telegram_id     BigInt   @unique
  username        String?  @db.VarChar(50)
  daily_protein_goal Float @default(120.0)
  daily_calorie_goal Float @default(2000.0)
  daily_water_goal   Float @default(3.0)
  water_bottle_size  Float @default(0.5)
  daily_carbs_goal   Float @default(200.0)
  daily_fats_goal    Float @default(65.0)
  daily_fiber_goal   Float @default(30.0)
  daily_step_goal    Int      @default(10000)
  ai_provider        String?  @db.VarChar(20)
  ai_model           String?  @db.VarChar(80)
  ai_api_key         String?
  sex                String?  @db.VarChar(10)
  weight_kg          Float?
  height_cm          Float?
  age                Int?
  activity_level     String?  @db.VarChar(20)
  fitness_goal       String?  @db.VarChar(20)
  dietary_restrictions String?
  ai_features_enabled Boolean @default(false)
  ai_coaching_prefs   Json?
  training_focus     String?  @db.VarChar(20)
  access_token       String?  @unique @db.VarChar(64)
  strava_athlete_id    BigInt?
  strava_access_token  String?
  strava_refresh_token String?
  strava_token_expires Int?
  strava_scope         String?  @db.VarChar(100)
  strava_last_synced_at DateTime?
  created_at      DateTime? @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  saved_foods SavedFood[]
  food_logs   FoodLog[]
  water_logs  WaterLog[]
  run_logs    RunLog[]
  workout_templates WorkoutTemplate[]
  workout_logs      WorkoutLog[]
  step_logs         StepLog[]
  coach_state       CoachState?
  progress_snapshots ProgressSnapshot[]
  strava_ignored_activities StravaIgnoredActivity[]

  @@map("users")
}

model SavedFood {
  id            Int      @id @default(autoincrement())
  user_id       Int
  name          String   @db.VarChar(100)
  description   String?
  image_path    String?  @db.VarChar(255)
  calories      Float
  protein       Float
  carbohydrates Float
  fats          Float
  fiber         Float    @default(0.0)
  serving_label String?  @db.VarChar(100)
  source        String?  @default("gemini") @db.VarChar(20)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs FoodLog[]

  @@unique([user_id, name], name: "uq_user_food_name")
  @@index([user_id])
  @@index([name])
  @@map("saved_foods")
}

model FoodLog {
  id             Int      @id @default(autoincrement())
  user_id        Int
  saved_food_id  Int?
  food_name      String?  @db.VarChar(100)
  raw_text_input String?
  image_path     String?  @db.VarChar(255)
  servings       Float    @default(1.0)
  calories       Float?
  protein        Float?
  carbohydrates  Float?
  fats           Float?
  fiber          Float?   @default(0.0)
  source         String?  @default("gemini") @db.VarChar(20)
  logged_at      DateTime @default(now())

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  saved_food SavedFood? @relation(fields: [saved_food_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([user_id, logged_at])
  @@index([saved_food_id])
  @@map("food_logs")
}

model WaterLog {
  id                Int      @id @default(autoincrement())
  user_id           Int
  amount_liters     Float
  bottles           Float?
  water_bottle_size Float?
  logged_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, logged_at])
  @@map("water_logs")
}

model RunLog {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  strava_activity_id  BigInt?  @unique
  distance_meters     Float
  duration_seconds    Int
  calories_burned     Float
  pace_per_km         Float?
  average_heartrate   Float?
  elevation_gain      Float?
  name                String?  @db.VarChar(200)
  source              String   @default("manual") @db.VarChar(20)
  // Runs count towards the calorie allowance unless the user opts one out.
  // Was @default(false) while nothing ever set it, so the flag was dead; now
  // that `src/lib/budget.ts` reads it, false-by-default would zero all credit.
  added_to_allowance  Boolean  @default(true)
  run_date            DateTime
  logged_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, run_date])
  @@index([user_id, logged_at])
  @@map("run_logs")
}

model WorkoutTemplate {
  id          Int      @id @default(autoincrement())
  user_id     Int
  name        String   @db.VarChar(100)
  exercises   Json
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workout_logs WorkoutLog[]

  @@index([user_id])
  @@map("workout_templates")
}

model WorkoutLog {
  id               Int      @id @default(autoincrement())
  user_id          Int
  template_id      Int?
  name             String   @db.VarChar(200)
  duration_minutes Int?
  calories_burned  Float?
  notes            String?
  source           String   @default("manual") @db.VarChar(20)
  analysis         Json?
  prs              Json?
  workout_date     DateTime
  logged_at        DateTime @default(now())

  user      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  template  WorkoutTemplate?  @relation(fields: [template_id], references: [id], onDelete: SetNull)
  exercises ExerciseLog[]

  @@index([user_id, workout_date])
  @@index([user_id, logged_at])
  @@index([template_id])
  @@map("workout_logs")
}

model ExerciseLog {
  id             Int    @id @default(autoincrement())
  workout_log_id Int
  exercise_name  String @db.VarChar(100)
  sets           Json
  order          Int
  exercise_id    Int?
  exercise       Exercise? @relation(fields: [exercise_id], references: [id], onDelete: SetNull)

  workout WorkoutLog @relation(fields: [workout_log_id], references: [id], onDelete: Cascade)

  // `exercise_name` is the join key for every progress/PR/prediction query
  // (always paired with `workout.user_id`, which lives on the parent row — so a
  // plain index on the name is the best this table can offer).
  @@index([workout_log_id])
  @@index([exercise_name])
  @@index([exercise_id])
  @@map("exercise_logs")
}

model StepLog {
  id        Int      @id @default(autoincrement())
  user_id   Int
  steps     Int
  date      DateTime @db.Date
  source    String   @default("shortcut") @db.VarChar(20)
  logged_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // No @@index([user_id]) — @@unique([user_id, date]) already indexes that prefix.
  @@unique([user_id, date])
  @@map("step_logs")
}

model CoachState {
  id               Int       @id @default(autoincrement())
  user_id          Int       @unique
  last_nudge_topic String?   @db.VarChar(50)
  last_nudge_at    DateTime?
  nudge_history    Json?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("coach_state")
}

model Exercise {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(200)
  category          String   @db.VarChar(50)
  primary_muscles   Json
  secondary_muscles Json
  equipment         String?  @db.VarChar(50)

  exercise_logs ExerciseLog[]
  progress_snapshots ProgressSnapshot[]

  @@index([name])
  @@index([category])
  @@map("exercises")
}

model ProgressSnapshot {
  id                        Int       @id @default(autoincrement())
  user_id                   Int
  exercise_id               Int?
  exercise_name             String    @db.VarChar(100)
  estimated_1rm             Float
  // best_set_* describe the best-*estimated-1RM* set (77.5×10 can beat 80×8),
  // which is why they must not be rendered as a "weight PR".
  best_set_weight           Float
  best_set_reps             Int
  // best_weight/_reps are the genuinely heaviest set ever logged — this is what
  // the PR list shows.
  best_weight               Float     @default(0)
  best_weight_reps          Int       @default(0)
  total_volume_7d           Float     @default(0)
  // last_improved_at is the e1RM/stall clock: it moves whenever *any* record
  // (e1RM, weight or reps) is set, and drives sessions_since_improvement.
  last_improved_at          DateTime?
  // best_weight_improved_at moves only when best_weight/_reps do, so the PR
  // list can date a weight PR without borrowing an unrelated e1RM date.
  best_weight_improved_at   DateTime?
  sessions_since_improvement Int      @default(0)
  updated_at                DateTime  @default(now()) @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exercise_id], references: [id], onDelete: SetNull)

  @@unique([user_id, exercise_name])
  @@index([user_id])
  @@map("progress_snapshots")
}

/// Tombstone for a Strava activity the user deleted from Quadfather. Without it
/// the next `POST /api/runs/sync` re-imports the very run they just removed.
model StravaIgnoredActivity {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  strava_activity_id BigInt
  created_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, strava_activity_id])
  @@map("strava_ignored_activities")
}
